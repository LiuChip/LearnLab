{
  "name": "learnlab",
  "version": "0.1.0",
  "private": true,
  "description": "LearnLab - Local Interactive Lab Browser",
  "scripts": {
    "dev": "pnpm -F desktop dev",
    "build": "pnpm -r build",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0",
    "typescript-eslint": "^8.0.0",
    "@types/node": "^22.0.0"
  }
}
